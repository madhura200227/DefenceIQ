# ==============================================================================
# DefenceIQ Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and populate keys as needed.
# All external API keys are optional: when omitted, DefenceIQ automatically
# falls back to deterministic rule-based heuristics and local datasets.

# PostgreSQL connection string (e.g. Neon Serverless Postgres).
# Leave empty to use local SQLite (DEFENCEIQ_DB).
DATABASE_URL=postgresql://user:password@ep-example.us-west-2.aws.neon.tech/neondb?sslmode=require
DEFENCEIQ_DB=:memory:

# Simulation trace pacing (seconds between emitted events)
PACE=0.6

# AI Model Providers (both supported; automatic deterministic fallback when unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5

# Threat Intelligence Providers (optional; falls back to local reputation dataset)
ABUSEIPDB_API_KEY=
VT_API_KEY=
OTX_API_KEY=

# Allowed CORS & WebSocket Origins
DEFENCEIQ_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://defenceiq-theta.vercel.app,https://defenceiq-5iazzx3nb-madhura-lakade-s-projects.vercel.app
